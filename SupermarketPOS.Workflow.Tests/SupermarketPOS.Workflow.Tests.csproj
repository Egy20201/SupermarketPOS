<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SupermarketPOS.Workflow.Tests</RootNamespace>
    <AssemblyName>SupermarketPOS.Workflow.Tests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS8002;NETSDK1138;xUnit1031</NoWarn>
  </PropertyGroup>

  <!--
    The production projects target net48 (WPF + EF6). To exercise the
    framework-agnostic Workflow/ code on Linux CI we re-compile only those
    source files into this net8.0 test assembly via <Compile Link="..." />.
    No reference to the net48 SupermarketPOS.Business assembly is needed,
    which keeps the tests cross-platform.
  -->
  <ItemGroup>
    <Compile Include="..\SupermarketPOS.Business\Workflow\**\*.cs">
      <Link>Workflow\%(RecursiveDir)%(FileName)%(Extension)</Link>
    </Compile>
    <!--
      Phase 5: framework-agnostic posting helpers. We exclude the EF-bound
      FiscalPeriodLockChecker (it needs SupermarketPOS.Data which is net48-only)
      while still compiling the pure-logic helpers under test.
    -->
    <Compile Include="..\SupermarketPOS.Business\Posting\**\*.cs"
             Exclude="..\SupermarketPOS.Business\Posting\IFiscalPeriodLockChecker.cs">
      <Link>Posting\%(RecursiveDir)%(FileName)%(Extension)</Link>
    </Compile>
    <Compile Include="..\SupermarketPOS.Core\Entities\DocumentStatus.cs">
      <Link>Entities\DocumentStatus.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
