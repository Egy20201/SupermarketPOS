<local:BaseWindow x:Class="SupermarketPOS.UI.InventoryReportWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="تقييم المخزون"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="📦 تقييم المخزون" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock Text="المخزن:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="WarehouseFilterCombo" Width="200" Margin="0,0,16,0"/>
                <TextBlock Text="تاريخ التقييم:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="AsOfDatePicker" Width="140" SelectedDate="{x:Static sys:DateTime.Today}" Margin="0,0,16,0"/>
                <CheckBox x:Name="ShowZeroStockCheckBox" Content="إظهار الأصناف صفرية المخزون" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="🔄 تحديث" Style="{StaticResource PrimaryButtonStyle}" Width="100" Click="RefreshButton_Click"/>
                <Button Content="📊 تصدير" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="8,0,0,0" Click="ExportButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TotalItemsText" FontSize="14" FontWeight="Bold" Margin="0,0,30,0"/>
                <TextBlock x:Name="TotalQuantityText" FontSize="14" FontWeight="Bold" Margin="0,0,30,0"/>
                <TextBlock x:Name="TotalValueText" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding ProductId}" Width="70"/>
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130"/>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="250"/>
                    <DataGridTextColumn Header="الفئة" Binding="{Binding CategoryName}" Width="130"/>
                    <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="130"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="90"/>
                    <DataGridTextColumn Header="متوسط التكلفة" Binding="{Binding AverageCost, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="القيمة" Binding="{Binding TotalValue, StringFormat={}{0:N2}}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource HeaderBorderStyle}" Margin="0,16,0,0">
            <TextBlock x:Name="FooterText" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</local:BaseWindow>