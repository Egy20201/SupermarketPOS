<local:BaseWindow x:Class="SupermarketPOS.UI.BackupWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="نسخ احتياطي"
                  Width="500" Height="300"
                  WindowStartupLocation="CenterScreen"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="💾 النسخ الاحتياطي" Style="{StaticResource Heading1Style}" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="35" Height="35" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="قاعدة البيانات:" Style="{StaticResource LabelStyle}"/>
            <TextBlock x:Name="DatabaseNameText" Grid.Row="2" Text="SupermarketDB" FontSize="14" Margin="0,0,0,20"/>

            <Button x:Name="BackupButton" Grid.Row="3" Content="📤 إنشاء نسخة احتياطية" Style="{StaticResource SuccessButtonStyle}" Height="45" Click="BackupButton_Click"/>

            <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</local:BaseWindow>