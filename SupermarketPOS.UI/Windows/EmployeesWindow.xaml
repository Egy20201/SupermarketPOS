<Window x:Class="SupermarketPOS.UI.Windows.EmployeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الموظفين" WindowState="Maximized" WindowStyle="None"
        FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="👥 الموظفين" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnAdd" Content="➕ إضافة" Style="{StaticResource PrimaryButtonStyle}" Width="100" Click="Add_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnEdit" Content="✏️ تعديل" Style="{StaticResource SecondaryButtonStyle}" Width="100" Click="Edit_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnDeactivate" Content="🔒 تعطيل" Style="{StaticResource DangerButtonStyle}" Width="100" Click="Deactivate_Click"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="0">
            <DataGrid x:Name="EmployeesGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="100"/>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="200"/>
                    <DataGridTextColumn Header="الوظيفة" Binding="{Binding Position}" Width="150"/>
                    <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding BasicSalary, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="القسم" Binding="{Binding Department.Name}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding IsActive}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>