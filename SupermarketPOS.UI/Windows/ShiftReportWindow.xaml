<local:BaseWindow x:Class="SupermarketPOS.UI.ShiftReportWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="تقرير الشيفتات"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔄 تقرير الشيفتات (الورديات)" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="FromDatePicker" Width="140" SelectedDate="{x:Static sys:DateTime.Today}" Margin="0,0,16,0"/>
                <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="ToDatePicker" Width="140" SelectedDate="{x:Static sys:DateTime.Today}" Margin="0,0,16,0"/>
                <TextBlock Text="الكاشير:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="UserFilterCombo" Width="200" Margin="0,0,16,0"/>
                <Button Content="🔄 تحديث" Style="{StaticResource PrimaryButtonStyle}" Width="100" Click="RefreshButton_Click"/>
                <Button Content="📊 تصدير Excel" Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="8,0,0,0" Click="ExportButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TotalShiftsText" FontSize="14" FontWeight="Bold" Margin="0,0,30,0"/>
                <TextBlock x:Name="TotalSalesText" FontSize="14" FontWeight="Bold" Margin="0,0,30,0" Foreground="{DynamicResource PrimaryBrush}"/>
                <TextBlock x:Name="TotalCashText" FontSize="14" FontWeight="Bold" Margin="0,0,30,0" Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock x:Name="TotalDifferenceText" FontSize="14" FontWeight="Bold"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="ReportGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding ShiftDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                    <DataGridTextColumn Header="الكاشير" Binding="{Binding UserName}" Width="150"/>
                    <DataGridTextColumn Header="بداية" Binding="{Binding StartTime, StringFormat=HH:mm}" Width="80"/>
                    <DataGridTextColumn Header="نهاية" Binding="{Binding EndTime, StringFormat=HH:mm}" Width="80"/>
                    <DataGridTextColumn Header="فواتير" Binding="{Binding TotalInvoices}" Width="80"/>
                    <DataGridTextColumn Header="المبيعات" Binding="{Binding TotalSales, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="متوقع" Binding="{Binding ExpectedCash, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="فعلي" Binding="{Binding ActualCash, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="الفرق" Binding="{Binding Difference, StringFormat={}{0:N2}}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource HeaderBorderStyle}">
            <TextBlock Text="💡 دبل كليك على الشيفت لعرض تفاصيل الفواتير" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</local:BaseWindow>