<local:BaseWindow x:Class="SupermarketPOS.UI.StockLossWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="تالف / هالك"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="🗑️ إذن تالف / هالك" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel>
                <TextBlock Text="المخزن:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="WarehouseCombo" Width="200" Margin="0,0,24,0"/>
                <TextBlock Text="بحث عن منتج:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ProductSearchBox" Width="300" KeyDown="ProductSearchBox_KeyDown"/>
                <Button Content="🔍 بحث" Style="{StaticResource SecondaryButtonStyle}" Width="80" Margin="8,0,0,0" Click="SearchButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <Button Content="🔄 مسح الكل" Style="{StaticResource SecondaryButtonStyle}" Width="120" Click="ClearButton_Click"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="LossGrid" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding ProductId}" Width="70"/>
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130"/>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="250"/>
                    <DataGridTextColumn Header="المخزون الحالي" Binding="{Binding CurrentStock}" Width="120"/>
                    <DataGridTextColumn Header="الكمية التالفة" Binding="{Binding Quantity}" Width="120"/>
                    <DataGridTextColumn Header="التكلفة" Binding="{Binding Cost, StringFormat={}{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTemplateColumn Header="" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️" Style="{StaticResource IconButtonStyle}" Click="DeleteItem_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="ملاحظات:" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                <TextBox x:Name="NotesBox" Height="60" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TotalLossText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <Button Content="💾 حفظ الإذن" Style="{StaticResource SuccessButtonStyle}" Width="130" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</local:BaseWindow>