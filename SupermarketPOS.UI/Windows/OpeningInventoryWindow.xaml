<local:BaseWindow x:Class="SupermarketPOS.UI.OpeningInventoryWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="أرصدة أول المدة"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="📦 أرصدة أول المدة" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock Text="المخزن:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="WarehouseCombo" Width="250" Margin="0,0,16,0"/>
                <TextBlock Text="🔍 بحث:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Width="250" Margin="0,0,16,0"/>
                <Button Content="🔄 تحميل" Style="{StaticResource SecondaryButtonStyle}" Width="100" Click="LoadButton_Click"/>
                <Button Content="💾 حفظ" Style="{StaticResource SuccessButtonStyle}" Width="100" Margin="8,0,0,0" Click="SaveButton_Click"/>
                <Button Content="📊 تصدير" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="8,0,0,0" Click="ExportButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding ProductId}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="250" IsReadOnly="True"/>
                    <DataGridTextColumn Header="كمية أول المدة" Binding="{Binding Quantity}" Width="130"/>
                    <DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding UnitCost, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="القيمة الإجمالية" Binding="{Binding TotalValue, StringFormat={}{0:N2}}" Width="130" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource HeaderBorderStyle}" Margin="0,16,0,0">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TotalItemsText" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,30,0"/>
                <TextBlock x:Name="TotalValueText" FontSize="14" FontWeight="Bold" Foreground="Yellow"/>
            </WrapPanel>
        </Border>
    </Grid>
</local:BaseWindow>