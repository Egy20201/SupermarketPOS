<local:BaseWindow x:Class="SupermarketPOS.UI.StockCardWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="كارت الصنف"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="📋 كارت الصنف - حركة المخزون" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍 بحث عن منتج:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ProductSearchBox" Grid.Column="1" Height="40" FontSize="16" KeyDown="ProductSearchBox_KeyDown"/>
                <Button x:Name="SearchButton" Grid.Column="2" Content="بحث" Style="{StaticResource PrimaryButtonStyle}" Width="100" Margin="8,0,0,0" Click="SearchButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <TextBlock x:Name="ProductInfoText" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel>
                <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="FromDatePicker" Width="140" SelectedDate="{x:Static sys:DateTime.Today}" Margin="0,0,16,0"/>
                <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="ToDatePicker" Width="140" SelectedDate="{x:Static sys:DateTime.Today}" Margin="0,0,16,0"/>
                <TextBlock Text="المخزن:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="WarehouseFilterCombo" Width="180" Margin="0,0,16,0"/>
                <Button Content="🔄 عرض" Style="{StaticResource SecondaryButtonStyle}" Width="100" Click="RefreshButton_Click"/>
                <Button Content="📊 تصدير" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="8,0,0,0" Click="ExportButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="StockCardGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="نوع الحركة" Binding="{Binding MovementType}" Width="100"/>
                    <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="120"/>
                    <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="120"/>
                    <DataGridTextColumn Header="وارد" Binding="{Binding QuantityIn}" Width="80"/>
                    <DataGridTextColumn Header="منصرف" Binding="{Binding QuantityOut}" Width="80"/>
                    <DataGridTextColumn Header="الرصيد" Binding="{Binding RunningBalance}" Width="80"/>
                    <DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding UnitCost, StringFormat={}{0:N2}}" Width="110"/>
                    <DataGridTextColumn Header="قيمة الحركة" Binding="{Binding MovementValue, StringFormat={}{0:N2}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource HeaderBorderStyle}" Margin="0,16,0,0">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TotalInText" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,30,0"/>
                <TextBlock x:Name="TotalOutText" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,30,0"/>
                <TextBlock x:Name="BalanceText" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,30,0"/>
                <TextBlock x:Name="BalanceValueText" FontSize="14" FontWeight="Bold" Foreground="Yellow"/>
            </WrapPanel>
        </Border>
    </Grid>
</local:BaseWindow>