<local:BaseWindow x:Class="SupermarketPOS.UI.SupplierStatementWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="كشف حساب مورد"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="📊 كشف حساب مورد" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel>
                <TextBlock Text="المورد:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SupplierCombo" Width="250" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,16,0"/>
                <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="FromDatePicker" Width="140" Margin="0,0,16,0"/>
                <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="ToDatePicker" Width="140" Margin="0,0,16,0"/>
                <Button Content="🔄 عرض" Style="{StaticResource PrimaryButtonStyle}" Width="100" Click="RefreshButton_Click"/>
                <Button Content="📊 تصدير" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="8,0,0,0" Click="ExportButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <TextBlock x:Name="SupplierInfoText" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="StatementGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="120"/>
                    <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="150"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource HeaderBorderStyle}">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock x:Name="OpeningBalanceText" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,30,0"/>
                <TextBlock x:Name="TotalDebitText" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,30,0"/>
                <TextBlock x:Name="TotalCreditText" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,30,0"/>
                <TextBlock x:Name="ClosingBalanceText" FontSize="14" FontWeight="Bold" Foreground="Yellow"/>
            </WrapPanel>
        </Border>
    </Grid>
</local:BaseWindow>