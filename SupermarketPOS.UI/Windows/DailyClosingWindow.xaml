<local:BaseWindow x:Class="SupermarketPOS.UI.DailyClosingWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="الإغلاق اليومي"
                  Width="550" Height="650"
                  WindowStartupLocation="CenterScreen"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="💰 الإغلاق اليومي" Style="{StaticResource Heading1Style}" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="35" Height="35" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="تاريخ الإغلاق:" Style="{StaticResource LabelStyle}"/>
                <DatePicker x:Name="ClosingDatePicker" SelectedDate="{x:Static sys:DateTime.Today}" IsEnabled="False"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="2" FontWeight="Bold" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="3" Margin="0,0,0,15">
                <TextBlock x:Name="TotalInvoicesText"/>
                <TextBlock x:Name="TotalSalesText"/>
                <TextBlock x:Name="TotalCashSalesText"/>
                <TextBlock x:Name="TotalCreditSalesText"/>
                <TextBlock x:Name="ExpectedCashText"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,15">
                <TextBlock Text="النقدية الفعلية:" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="ActualCashBox" Width="150" Text="0" TextAlignment="Center"/>
                <TextBlock x:Name="DifferenceText" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,0,0,15">
                <TextBlock Text="ملاحظات:" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="NotesBox" Height="60" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Content="🔒 إغلاق اليوم" Style="{StaticResource SuccessButtonStyle}" Width="120" Click="CloseDayButton_Click"/>
                <Button Content="🖨️ طباعة" Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="10,0,0,0" Click="PrintButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</local:BaseWindow>