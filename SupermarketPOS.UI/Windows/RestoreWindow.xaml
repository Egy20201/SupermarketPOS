<local:BaseWindow x:Class="SupermarketPOS.UI.RestoreWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="استعادة نسخة"
                  Width="500" Height="350"
                  WindowStartupLocation="CenterScreen"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="🔄 استعادة نسخة احتياطية" Style="{StaticResource Heading1Style}" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="35" Height="35" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <TextBlock Text="⚠️ تحذير: استعادة النسخة ستؤدي إلى فقدان جميع البيانات الحالية!" Foreground="White" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Grid.Row="2" Text="قاعدة البيانات:" Style="{StaticResource LabelStyle}"/>
            <TextBlock x:Name="DatabaseNameText" Grid.Row="3" Text="SupermarketDB" FontSize="14" Margin="0,0,0,20"/>

            <Button x:Name="RestoreButton" Grid.Row="4" Content="📁 اختر ملف النسخة الاحتياطية" Style="{StaticResource DangerButtonStyle}" Height="45" Click="RestoreButton_Click"/>

            <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</local:BaseWindow>