<local:BaseWindow x:Class="SupermarketPOS.UI.Windows.POSWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  xmlns:converters="clr-namespace:SupermarketPOS.UI.Converters"
                  xmlns:behaviors="clr-namespace:SupermarketPOS.UI.Behaviors"
                  Title="فاتورة مبيعات"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource SecondaryBrush}"
                  PreviewKeyDown="Window_PreviewKeyDown"
                  behaviors:GlobalKeyboardBehavior.IsEnabled="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🧾" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="فاتورة مبيعات" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="6"
                        Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <TextBlock x:Name="InvoiceStatusBadge" Text="جديدة" FontSize="11"
                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Content="✕" Width="36" Height="36"
                    Style="{StaticResource IconButtonStyle}" Click="CloseButton_Click"
                    ToolTip="إغلاق"/>
        </Grid>

        <!-- Action Ribbon -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}"
                Padding="12,10" Margin="0,0,0,10" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnSave" Content="💾  حفظ" Style="{DynamicResource SuccessButtonStyle}"
                            Width="110" Height="38" Margin="0,0,8,0" Command="{Binding SaveCommand}"
                            ToolTip="F12 - حفظ الفاتورة"/>
                    <Button x:Name="BtnNew" Content="📄  جديد" Style="{DynamicResource SecondaryButtonStyle}"
                            Width="100" Height="38" Margin="0,0,8,0" Command="{Binding NewCommand}"
                            ToolTip="F4 - فاتورة جديدة"/>
                    <Button x:Name="BtnPrint" Content="🖨️  طباعة" Style="{DynamicResource SecondaryButtonStyle}"
                            Width="100" Height="38" Margin="0,0,8,0" Command="{Binding PrintCommand}"
                            ToolTip="Ctrl+P - طباعة"/>
                    <Button x:Name="BtnClear" Content="🗑️  مسح" Style="{DynamicResource SecondaryButtonStyle}"
                            Width="90" Height="38" Margin="0,0,8,0" Command="{Binding ClearCommand}"
                            ToolTip="Esc - مسح الفاتورة"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="F12: حفظ  |  F4: جديد  |  Esc: مسح  |  Del: حذف صنف"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header: Invoice No / Date / Customer -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}"
                Padding="16,12" Margin="0,0,0,10" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="رقم الفاتورة" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="InvoiceNumberText" IsReadOnly="True"
                             FontSize="15" FontWeight="Bold" Text="{Binding InvoiceNumber}"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                             Padding="8,6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="التاريخ" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker x:Name="DatePicker" SelectedDate="{Binding InvoiceDate}"
                                FontSize="14" BorderThickness="1"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="العميل" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="CustomerCombo" DisplayMemberPath="Name" SelectedValuePath="Id"
                              ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              FontSize="14" BorderThickness="1"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Background="{DynamicResource InputBackgroundBrush}"
                              BorderBrush="{DynamicResource InputBorderBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="180">
                    <Border x:Name="CustomerBalanceBorder" Background="{DynamicResource SecondaryBrush}"
                            CornerRadius="8" Padding="10,6" Visibility="{Binding ShowBalance, Converter={StaticResource BoolToVisibilityConverter}}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="CustomerBalanceLabel" Text="الرصيد الحالي:"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="CustomerBalanceText" FontSize="14" FontWeight="Bold"
                                       Text="{Binding CustomerBalance, StringFormat=N2}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: Barcode + Grid | Summary Panel -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Barcode entry + Items DataGrid -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barcode Strip -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceElevatedBrush}"
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍 باركود / كود الصنف:"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="BarcodeBox" Grid.Column="1"
                                 FontSize="17" Height="38" Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource SecondaryBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                 behaviors:AutoCompleteBehavior.ItemsSource="{Binding Products}"
                                 behaviors:AutoCompleteBehavior.DisplayMemberPath="DisplayName"/>
                        <Button Grid.Column="2" Content="⚡ إضافة سريعة"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Height="38" Padding="14,0" Margin="8,0,0,0"
                                Command="{Binding AddProductCommand}"/>
                    </Grid>
                </Border>

                <!-- Items DataGrid -->
                <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}"
                        Padding="0" CornerRadius="12">
                    <DataGrid x:Name="CartGrid" 
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              RowHeight="42" ColumnHeaderHeight="40"
                              Background="Transparent" BorderThickness="0"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="None"
                              AlternatingRowBackground="{DynamicResource SurfaceElevatedBrush}"
                              RowBackground="{DynamicResource SecondaryBrush}"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              behaviors:DataGridKeyboardBehavior.IsEnabled="True"
                              behaviors:DataGridKeyboardBehavior.RemoveItemCommand="{Binding RemoveItemCommand}"
                              behaviors:DataGridKeyboardBehavior.AddNewRowCommand="{Binding AddNewEmptyRowCommand}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Height" Value="40"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="40" IsReadOnly="True"
                                                Binding="{Binding RowIndex}"/>
                            <DataGridTextColumn Header="اسم الصنف" Width="*" IsReadOnly="True"
                                                Binding="{Binding ProductName}"/>
                            <DataGridTextColumn Header="الكمية" Width="80"
                                                Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="السعر" Width="100"
                                                Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"/>
                            <DataGridTextColumn Header="خصم %" Width="80"
                                                Binding="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N1}}"/>
                            <DataGridTextColumn Header="الإجمالي" Width="110" IsReadOnly="True"
                                                Binding="{Binding Total, StringFormat={}{0:N2}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Validation error strip -->
                <Border x:Name="ValidationStrip" Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,6" Margin="0,6,0,0"
                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock x:Name="ValidationText" Text="{Binding ValidationMessage}" FontSize="13"
                               Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- Right: Summary + Payment Panel -->
            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}"
                    Padding="0" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceElevatedBrush}"
                            CornerRadius="16,16,0,0" Padding="16,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="ملخص الفاتورة" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,14,16,0">
                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="10" Padding="12,10" Margin="0,0,0,14"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="DiscountCheckBox" Content="خصم إجمالي"
                                                  IsChecked="{Binding HasGlobalDiscount}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  FontSize="13" FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="DiscountBox" Width="56" Height="28"
                                                     Text="{Binding GlobalDiscountPercent}"
                                                     IsEnabled="{Binding HasGlobalDiscount}"
                                                     Padding="6,0" VerticalContentAlignment="Center"
                                                     FontSize="13" TextAlignment="Center"
                                                     Background="{DynamicResource InputBackgroundBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"/>
                                            <TextBlock Text="%" VerticalAlignment="Center"
                                                       Margin="4,0,0,0" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="TaxCheckBox" Content="ضريبة القيمة المضافة 14%"
                                              IsChecked="{Binding HasTax}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المجموع الفرعي" Style="{StaticResource SummaryLabelStyle}"/>
                                <TextBlock x:Name="SubtotalText" Grid.Column="1" Text="{Binding SubtotalDisplay}" Style="{StaticResource SummaryValueStyle}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الخصم" Style="{StaticResource SummaryLabelStyle}"/>
                                <TextBlock x:Name="DiscountTotalText" Grid.Column="1" Text="{Binding DiscountDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الضريبة 14%" Style="{StaticResource SummaryLabelStyle}"/>
                                <TextBlock x:Name="TaxTotalText" Grid.Column="1" Text="{Binding TaxDisplay}" Style="{StaticResource SummaryValueStyle}"/>
                            </Grid>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="الإجمالي الصافي" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetTotalText" Grid.Column="1" Text="{Binding NetTotalDisplay}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource SecondaryBrush}"
                                    CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="طريقة السداد" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <ComboBox x:Name="PaymentMethodCombo" SelectedItem="{Binding PaymentMethod}" Height="36" FontSize="14" FontWeight="Bold"
                                              ItemsSource="{Binding PaymentMethods}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              Background="{DynamicResource InputBackgroundBrush}"
                                              BorderBrush="{DynamicResource InputBorderBrush}"/>
                                    <TextBlock Text="المبلغ المدفوع" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,0"/>
                                    <TextBox x:Name="PaidAmountBox" Height="34" Padding="8,0"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="15" FontWeight="SemiBold"
                                             TextAlignment="Right"
                                             Background="{DynamicResource InputBackgroundBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                             Margin="0,4,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="المتبقي / الباقي" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RemainingText" Grid.Column="1" Text="{Binding RemainingDisplay}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="14,8">
                        <TextBlock Text="الحسابات تتم تلقائياً في الوقت الحقيقي ⚡"
                                   FontSize="11" FontStyle="Italic"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:BaseWindow>