<local:BaseWindow x:Class="SupermarketPOS.UI.VATReportWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="تقرير VAT"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🧾 تقرير ضريبة القيمة المضافة (VAT 14%)" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="FromDatePicker" Width="140" SelectedDate="{x:Static sys:DateTime.Today}" Margin="0,0,16,0"/>
                <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="ToDatePicker" Width="140" SelectedDate="{x:Static sys:DateTime.Today}" Margin="0,0,16,0"/>
                <Button Content="🔄 تحديث" Style="{StaticResource PrimaryButtonStyle}" Width="100" Click="RefreshButton_Click"/>
                <Button Content="📊 تصدير Excel" Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="8,0,0,0" Click="ExportButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TotalSalesText" FontSize="16" FontWeight="Bold" Margin="0,0,30,0"/>
                <TextBlock x:Name="TotalVATText" FontSize="16" FontWeight="Bold" Margin="0,0,30,0" Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock x:Name="NetSalesText" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="120"/>
                    <DataGridTextColumn Header="إجمالي المبيعات" Binding="{Binding TotalSales, StringFormat={}{0:N2}}" Width="150"/>
                    <DataGridTextColumn Header="الضريبة (14%)" Binding="{Binding VATAmount, StringFormat={}{0:N2}}" Width="150"/>
                    <DataGridTextColumn Header="صافي المبيعات" Binding="{Binding NetSales, StringFormat={}{0:N2}}" Width="150"/>
                    <DataGridTextColumn Header="عدد الفواتير" Binding="{Binding InvoiceCount}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource HeaderBorderStyle}">
            <TextBlock Text="💡 هذا التقرير جاهز للتقديم لمصلحة الضرائب" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</local:BaseWindow>