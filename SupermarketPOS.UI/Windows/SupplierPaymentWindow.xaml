<local:BaseWindow x:Class="SupermarketPOS.UI.SupplierPaymentWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="سداد مورد"
                  Width="980" Height="720"
                  WindowStartupLocation="CenterScreen"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="10">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="💵 إدارة سداد مورد" Style="{StaticResource Heading1Style}" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="35" Height="35" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="المعلومات" Style="{StaticResource Heading2Style}" Margin="0,0,0,8"/>

                            <TextBlock Text="المورد" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="SupplierCombo" Margin="0,0,0,10" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="SupplierCombo_SelectionChanged"/>

                            <TextBlock Text="رقم السداد" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="PaymentNumberBox" Margin="0,0,0,10" IsReadOnly="True"/>

                            <TextBlock Text="التاريخ" Style="{StaticResource LabelStyle}"/>
                            <DatePicker x:Name="PaymentDatePicker" SelectedDate="{x:Static sys:DateTime.Today}" Margin="0,0,0,10"/>

                            <TextBlock Text="طريقة الدفع" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="MethodCombo" Margin="0,0,0,10" SelectedIndex="0">
                                <ComboBoxItem Content="نقدي"/>
                                <ComboBoxItem Content="تحويل"/>
                                <ComboBoxItem Content="بطاقة"/>
                                <ComboBoxItem Content="شيك"/>
                            </ComboBox>

                            <TextBlock Text="المبلغ المطلوب توزيعه" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="AmountBox" Margin="0,0,0,10" TextChanged="AmountBox_TextChanged"/>

                            <TextBlock Text="ملاحظات" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="NotesBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                            <Separator Margin="0,8,0,8"/>
                            <TextBlock Text="سياق المورد" Style="{StaticResource Heading2Style}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="SupplierNameText" Margin="0,0,0,6"/>
                            <TextBlock x:Name="SupplierBalanceText" Margin="0,0,0,10"/>

                            <TextBlock Text="آخر الحركات" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <ListBox x:Name="RecentTransactionsList" Height="180" BorderThickness="0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="توزيع السداد على الفواتير المفتوحة" Style="{StaticResource Heading2Style}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="توزيع تلقائي" Padding="12,6" Click="AutoAllocate_Click"/>
                            <Button Grid.Column="3" Content="تصفير" Padding="12,6" Click="ClearAllocation_Click"/>
                        </Grid>

                        <DataGrid Grid.Row="1" x:Name="InvoiceGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="تحديد" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="*"/>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N2}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="المخصص" Binding="{Binding AllocationAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="SummaryText" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ValidationText" Foreground="#FFEF4444" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                <Button Content="💾 تسجيل السداد" Style="{StaticResource SuccessButtonStyle}" Width="180" Height="40" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</local:BaseWindow>