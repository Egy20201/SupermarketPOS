<Window x:Class="SupermarketPOS.UI.Windows.PipelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="خط أنابيب المبيعات" WindowState="Maximized" WindowStyle="None"
        FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="📊 خط أنابيب المبيعات" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="PipelinePanel" Orientation="Horizontal"/>
        </ScrollViewer>
    </Grid>
</Window>