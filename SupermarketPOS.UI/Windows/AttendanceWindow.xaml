<Window x:Class="SupermarketPOS.UI.Windows.AttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الحضور والانصراف" WindowState="Maximized" WindowStyle="None"
        FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="🕐 الحضور والانصراف" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="الموظف:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="EmployeeCombo" Width="250" DisplayMemberPath="FullName" SelectedValuePath="Id" Margin="0,0,16,0"/>
                <Button x:Name="BtnCheckIn" Content="✅ حضور" Style="{DynamicResource SuccessButtonStyle}" Width="100" Click="CheckIn_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnCheckOut" Content="🚪 انصراف" Style="{DynamicResource DangerButtonStyle}" Width="100" Click="CheckOut_Click"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="0">
            <DataGrid x:Name="AttendanceGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100"/>
                    <DataGridTextColumn Header="حضور" Binding="{Binding CheckIn, StringFormat=HH:mm}" Width="80"/>
                    <DataGridTextColumn Header="انصراف" Binding="{Binding CheckOut, StringFormat=HH:mm}" Width="80"/>
                    <DataGridTextColumn Header="تأخير (دقائق)" Binding="{Binding LateMinutes}" Width="100"/>
                    <DataGridTextColumn Header="إضافي (دقائق)" Binding="{Binding OvertimeMinutes}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>