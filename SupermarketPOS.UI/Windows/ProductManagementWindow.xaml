<local:BaseWindow x:Class="SupermarketPOS.UI.Windows.ProductManagementWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="إدارة المنتجات"
                  Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
            <StackPanel>
                <TextBlock Text="إدارة المنتجات" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                <Button x:Name="ProductsNavButton" Content="المنتجات" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Click="ProductsNavButton_Click"/>
                <Button x:Name="CategoriesNavButton" Content="الفئات" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="CategoriesNavButton_Click"/>
                <Button x:Name="UnitsNavButton" Content="الوحدات" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="UnitsNavButton_Click"/>
                <Button x:Name="BulkNavButton" Content="إدخال جماعي" Style="{StaticResource SecondaryButtonStyle}" Click="BulkNavButton_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <ContentControl x:Name="ContentHost"/>
        </Border>
    </Grid>
</local:BaseWindow>