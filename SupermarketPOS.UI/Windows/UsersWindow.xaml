<local:BaseWindow x:Class="SupermarketPOS.UI.UsersWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="المستخدمين والصلاحيات"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="👥 المستخدمين والصلاحيات" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="➕ إضافة" Style="{StaticResource PrimaryButtonStyle}" Width="110" Click="AddButton_Click"/>
                    <Button Content="✏️ تعديل" Style="{StaticResource SecondaryButtonStyle}" Width="110" Margin="8,0,0,0" Click="EditButton_Click"/>
                    <Button Content="🗑️ حذف" Style="{StaticResource DangerButtonStyle}" Width="110" Margin="8,0,0,0" Click="DeleteButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🔄" Style="{StaticResource IconButtonStyle}" Click="RefreshButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Tag="Search" TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="RoleFilterCombo" Grid.Column="2" Width="150" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel>
                <StackPanel Width="80" Margin="0,0,16,0">
                    <TextBlock Text="الكود" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="CodeBox" Width="80" IsReadOnly="True" Background="{DynamicResource InputDisabledBrush}"/>
                </StackPanel>
                <StackPanel Width="200" Margin="0,0,16,0">
                    <TextBlock Text="اسم المستخدم *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="UsernameBox" Width="200"/>
                </StackPanel>
                <StackPanel Width="200" Margin="0,0,16,0">
                    <TextBlock Text="كلمة المرور" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="PasswordBox" Width="200"/>
                </StackPanel>
                <StackPanel Width="250" Margin="0,0,16,0">
                    <TextBlock Text="الاسم الكامل *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="FullNameBox" Width="250"/>
                </StackPanel>
                <StackPanel Width="150" Margin="0,0,16,0">
                    <TextBlock Text="الصلاحية" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="RoleCombo" Width="150">
                        <ComboBoxItem Content="Admin"/>
                        <ComboBoxItem Content="Manager"/>
                        <ComboBoxItem Content="Cashier"/>
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="IsActiveCheck" Content="نشط" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="UsersGrid" MouseDoubleClick="UsersGrid_MouseDoubleClick" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="150"/>
                    <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="250"/>
                    <DataGridTextColumn Header="الصلاحية" Binding="{Binding Role}" Width="120"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="❌ إلغاء" Style="{StaticResource SecondaryButtonStyle}" Width="110" Click="CancelButton_Click"/>
                <Button Content="💾 حفظ" Style="{StaticResource SuccessButtonStyle}" Width="110" Margin="8,0,0,0" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</local:BaseWindow>