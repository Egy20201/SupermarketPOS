<Window x:Class="SupermarketPOS.UI.Windows.RoleManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة الصلاحيات" WindowState="Maximized" WindowStyle="None"
        FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="الأدوار" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,12"/>
                <ListBox x:Name="RolesList" Grid.Row="1" DisplayMemberPath="Name" SelectedValuePath="Id"
                         SelectionChanged="RolesList_SelectionChanged" Background="Transparent" BorderThickness="0"/>
                <Button Grid.Row="2" Content="➕ إضافة دور" Style="{StaticResource PrimaryButtonStyle}" Height="40" Click="AddRole_Click" Margin="0,12,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock x:Name="SelectedRoleText" Text="اختر دور" Style="{StaticResource CardHeaderStyle}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnSavePermissions" Content="💾 حفظ" Style="{StaticResource SuccessButtonStyle}" Width="100" Height="36" HorizontalAlignment="Right" Click="SavePermissions_Click" Margin="16,0,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="PermissionsPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>