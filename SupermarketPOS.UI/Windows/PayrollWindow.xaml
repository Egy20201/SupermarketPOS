<Window x:Class="SupermarketPOS.UI.Windows.PayrollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الرواتب" WindowState="Maximized" WindowStyle="None"
        FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="💰 الرواتب" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <WrapPanel>
                <TextBlock Text="السنة:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="YearBox" Width="80" Text="2026" Margin="0,0,16,0"/>
                <TextBlock Text="الشهر:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="MonthCombo" Width="100" Margin="0,0,16,0"/>
                <Button x:Name="BtnGenerate" Content="⚙️ إنشاء الرواتب" Style="{StaticResource PrimaryButtonStyle}" Width="140" Click="Generate_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnApprove" Content="✅ اعتماد" Style="{StaticResource SuccessButtonStyle}" Width="100" Click="Approve_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnPost" Content="📤 ترحيل" Style="{StaticResource DangerButtonStyle}" Width="100" Click="Post_Click"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Right">
                <TextBlock x:Name="TotalEmployeesText" FontSize="14"/>
                <TextBlock x:Name="TotalNetText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="0">
            <DataGrid x:Name="PayrollGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="200"/>
                    <DataGridTextColumn Header="الراتب" Binding="{Binding BasicSalary, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="البدلات" Binding="{Binding Allowances, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الخصومات" Binding="{Binding Deductions, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الإضافي" Binding="{Binding OvertimeAmount, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="خصم التأخير" Binding="{Binding LateDeduction, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الصافي" Binding="{Binding NetSalary, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>