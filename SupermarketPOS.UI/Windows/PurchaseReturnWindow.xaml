<local:BaseWindow x:Class="SupermarketPOS.UI.PurchaseReturnWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="مرتجعات المشتريات"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="↩️ مرتجعات المشتريات" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel>
                <TextBlock Text="المخزن:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="WarehouseCombo" Width="200" Margin="0,0,16,0"/>
                <TextBlock Text="🔍 رقم الفاتورة:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="InvoiceSearchBox" Width="200" KeyDown="InvoiceSearch_KeyDown"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel>
                <TextBlock x:Name="OriginalInvoiceText" FontWeight="Bold" Margin="0,0,30,0"/>
                <TextBlock x:Name="SupplierInfoText" FontWeight="Bold"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="💾 حفظ المرتجع" Style="{StaticResource SuccessButtonStyle}" Width="130" Click="SaveButton_Click"/>
                <Button Content="🗑️ إلغاء" Style="{StaticResource SecondaryButtonStyle}" Width="110" Margin="8,0,0,0" Click="CancelButton_Click"/>
                <Button Content="🖨️ طباعة" Style="{StaticResource SecondaryButtonStyle}" Width="110" Margin="8,0,0,0" Click="PrintButton_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="ReturnGrid" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="250" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الكمية الأصلية" Binding="{Binding OriginalQuantity}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الكمية المرتجعة" Binding="{Binding ReturnQuantity}" Width="120"/>
                    <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="120" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel HorizontalAlignment="Right">
                <TextBlock x:Name="TotalReturnText" FontSize="16" FontWeight="Bold" Margin="0,0,30,0"/>
                <TextBlock x:Name="SupplierBalanceText" FontSize="16" FontWeight="Bold"/>
            </WrapPanel>
        </Border>
    </Grid>
</local:BaseWindow>