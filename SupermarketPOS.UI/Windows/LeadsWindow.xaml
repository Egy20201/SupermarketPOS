<Window x:Class="SupermarketPOS.UI.Windows.LeadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="العملاء المحتملين" WindowState="Maximized" WindowStyle="None"
        FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="🎯 العملاء المحتملين" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnAdd" Content="➕ إضافة" Style="{StaticResource PrimaryButtonStyle}" Width="120" Click="AddLead_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnConvert" Content="🔄 تحويل لعميل" Style="{StaticResource SuccessButtonStyle}" Width="140" Click="ConvertLead_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnContacted" Content="📞 تم التواصل" Style="{StaticResource SecondaryButtonStyle}" Width="130" Click="MarkContacted_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TotalLeadsText" FontSize="14" FontWeight="Bold" Margin="0,0,30,0"/>
                <TextBlock x:Name="NewLeadsText" FontSize="14" Margin="0,0,30,0"/>
                <TextBlock x:Name="QualifiedText" FontSize="14" Foreground="{DynamicResource PrimaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="0">
            <DataGrid x:Name="LeadsGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="100"/>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding FullName}" Width="180"/>
                    <DataGridTextColumn Header="الشركة" Binding="{Binding CompanyName}" Width="150"/>
                    <DataGridTextColumn Header="التليفون" Binding="{Binding Phone}" Width="130"/>
                    <DataGridTextColumn Header="المصدر" Binding="{Binding Source}" Width="100"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="القيمة" Binding="{Binding PotentialValue, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>