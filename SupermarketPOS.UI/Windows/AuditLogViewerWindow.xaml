<Window x:Class="SupermarketPOS.UI.Windows.AuditLogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سجل التدقيق"
        WindowState="Maximized"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="📋 سجل التدقيق" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <WrapPanel>
                <TextBlock Text="الإجراء:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ActionFilter" Width="180" Margin="0,0,16,0"/>
                <TextBlock Text="الجدول:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="EntityFilter" Width="180" Margin="0,0,16,0"/>
                <Button Content="🔍 تصفية" Style="{StaticResource PrimaryButtonStyle}" Width="100" Click="FilterButton_Click"/>
                <Button Content="🔄 تحديث" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="8,0,0,0" Click="RefreshButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Timestamp, StringFormat=yyyy/MM/dd HH:mm:ss}" Width="150"/>
                    <DataGridTextColumn Header="المستخدم" Binding="{Binding UserId}" Width="80"/>
                    <DataGridTextColumn Header="الإجراء" Binding="{Binding Action}" Width="150"/>
                    <DataGridTextColumn Header="الجدول" Binding="{Binding EntityName}" Width="120"/>
                    <DataGridTextColumn Header="المعرف" Binding="{Binding EntityId}" Width="80"/>
                    <DataGridTextColumn Header="الجهاز" Binding="{Binding Device}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="16">
            <TextBlock x:Name="TotalText" Text="عدد السجلات: 0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>