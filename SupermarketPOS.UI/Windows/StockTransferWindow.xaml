<local:BaseWindow x:Class="SupermarketPOS.UI.StockTransferWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="تحويل بين المخازن"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="🔄 تحويل بين المخازن" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel>
                <TextBlock Text="رقم الإذن:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TransferNumberText" Width="100" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,24,0"/>
                <TextBlock Text="التاريخ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="DatePicker" Width="150" SelectedDate="{x:Static sys:DateTime.Today}"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="من مخزن:" Width="80" VerticalAlignment="Center"/>
                    <TextBox x:Name="FromWarehouseCodeBox" Width="80" TextAlignment="Center"/>
                    <TextBox x:Name="FromWarehouseNameBox" Width="250" IsReadOnly="True" Background="{DynamicResource InputDisabledBrush}" Margin="8,0,0,0"/>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="إلى مخزن:" Width="80" VerticalAlignment="Center"/>
                    <TextBox x:Name="ToWarehouseCodeBox" Width="80" TextAlignment="Center"/>
                    <TextBox x:Name="ToWarehouseNameBox" Width="250" IsReadOnly="True" Background="{DynamicResource InputDisabledBrush}" Margin="8,0,0,0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="➕ إضافة منتج" Style="{StaticResource PrimaryButtonStyle}" Width="130" Click="AddProductButton_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="TransferGrid" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="كود الصنف" Binding="{Binding ProductCode}" Width="130"/>
                    <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="280"/>
                    <DataGridTextColumn Header="الكمية المتاحة" Binding="{Binding AvailableQuantity}" Width="120"/>
                    <DataGridTextColumn Header="الكمية المنقولة" Binding="{Binding Quantity}" Width="120"/>
                    <DataGridTemplateColumn Header="" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️" Style="{StaticResource IconButtonStyle}" Click="DeleteItem_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel HorizontalAlignment="Right">
                <TextBlock x:Name="TotalItemsText" Margin="0,0,30,0"/>
                <TextBlock x:Name="TotalQuantityText"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource CardBorderStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 حفظ" Style="{StaticResource SuccessButtonStyle}" Width="110" Click="SaveButton_Click"/>
                <Button Content="🖨️ طباعة" Style="{StaticResource SecondaryButtonStyle}" Width="110" Margin="8,0,0,0" Click="PrintButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</local:BaseWindow>