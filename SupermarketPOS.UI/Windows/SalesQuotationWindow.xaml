<Window x:Class="SupermarketPOS.UI.Windows.SalesQuotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عرض سعر" WindowState="Maximized" WindowStyle="None"
        FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="📄 عرض سعر" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border x:Name="StatusBadge" CornerRadius="12" Padding="12,4" Background="#F59E0B">
                        <TextBlock x:Name="StatusText" Text="مسودة" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                </StackPanel>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnSaveDraft" Content="💾 حفظ كمسودة" Style="{StaticResource SecondaryButtonStyle}" Width="140" Height="38" Click="SaveDraft_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnApprove" Content="✅ اعتماد" Style="{StaticResource SuccessButtonStyle}" Width="120" Height="38" Click="Approve_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnPost" Content="📤 إرسال" Style="{StaticResource PrimaryButtonStyle}" Width="110" Height="38" Click="Post_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnCancel" Content="❌ إلغاء" Style="{StaticResource DangerButtonStyle}" Width="100" Height="38" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
        <Border x:Name="ErrorStrip" Grid.Row="2" Background="#FEE2E2" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontWeight="SemiBold"/>
        </Border>
        <Border Grid.Row="3" Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Width="200" Margin="0,0,16,0">
                        <TextBlock Text="رقم العرض" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="QuotationNumberBox" IsReadOnly="True" Background="{DynamicResource InputDisabledBrush}"/>
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,16,0">
                        <TextBlock Text="التاريخ" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="DatePicker"/>
                    </StackPanel>
                    <StackPanel Width="300">
                        <TextBlock Text="العميل" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="CustomerCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    </StackPanel>
                </WrapPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="الأصناف:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnAddItem" Content="➕ إضافة صنف" Style="{StaticResource SuccessButtonStyle}" Width="120" Height="30" Click="AddItem_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRemoveItem" Content="🗑️ حذف" Style="{StaticResource DangerButtonStyle}" Width="80" Height="30" Click="RemoveItem_Click"/>
                </StackPanel>
                <DataGrid Grid.Row="2" x:Name="ItemsGrid" AutoGenerateColumns="False" RowHeight="40" CellEditEnding="ItemsGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="خصم" Binding="{Binding Discount, StringFormat=N2}" Width="80"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat=N2}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock x:Name="SubtotalText" FontSize="16"/>
                    <TextBlock x:Name="TotalText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>