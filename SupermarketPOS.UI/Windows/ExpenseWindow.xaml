<local:BaseWindow x:Class="SupermarketPOS.UI.ExpenseWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  xmlns:local="clr-namespace:SupermarketPOS.UI"
                  Title="المصروفات"
                  WindowState="Maximized"
                  WindowStyle="None"
                  FlowDirection="RightToLeft"
                  Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="💸 المصروفات" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="✕" Width="40" Height="40" Style="{StaticResource IconButtonStyle}" Foreground="White" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel>
                <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="FromDatePicker" Width="140" Margin="0,0,16,0"/>
                <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="ToDatePicker" Width="140" Margin="0,0,16,0"/>
                <TextBlock Text="النوع:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="TypeFilterCombo" Width="120" Margin="0,0,16,0"/>
                <Button Content="🔄 تحديث" Style="{StaticResource SecondaryButtonStyle}" Width="100" Click="RefreshButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <WrapPanel>
                <TextBlock Text="التاريخ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="ExpenseDatePicker" Width="140" SelectedDate="{x:Static sys:DateTime.Today}" Margin="0,0,16,0"/>
                <TextBlock Text="البيان:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="DescriptionBox" Width="250" Margin="0,0,16,0"/>
                <TextBlock Text="المبلغ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="AmountBox" Width="100" Margin="0,0,16,0"/>
                <TextBlock Text="النوع:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="TypeCombo" Width="120" Margin="0,0,16,0"/>
                <Button Content="💾 حفظ" Style="{StaticResource SuccessButtonStyle}" Width="100" Click="SaveButton_Click"/>
                <Button Content="🔄 جديد" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="8,0,0,0" Click="ClearButton_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <TextBlock x:Name="TotalExpensesText" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="0">
            <DataGrid x:Name="ExpensesGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding ExpenseDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="250"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding ExpenseType}" Width="120"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTemplateColumn Header="" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️" Style="{StaticResource IconButtonStyle}" Click="DeleteButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</local:BaseWindow>