<Window x:Class="SupermarketPOS.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول" Width="400" Height="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" FlowDirection="RightToLeft"
        Background="{DynamicResource BackgroundBrush}">

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Margin="20" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Supermarket ERP" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border x:Name="ErrorBorder" Grid.Row="1" Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,15" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Text="" Foreground="White" FontSize="13"/>
            </Border>

            <TextBox x:Name="UsernameBox" Grid.Row="2" Height="40" Margin="0,0,0,10" FontSize="14" Padding="12,8" 
                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource InputBorderBrush}"/>

            <PasswordBox x:Name="PasswordBox" Grid.Row="3" Height="40" Margin="0,0,0,20" FontSize="14" Padding="12,8" 
                         Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource InputBorderBrush}"/>

            <Button x:Name="LoginButton" Grid.Row="4" Content="دخول" Height="45" FontSize="16" FontWeight="SemiBold" 
                    Style="{DynamicResource PrimaryButtonStyle}" Click="LoginButton_Click"/>

            <Button Grid.Row="5" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" 
                    Foreground="{DynamicResource TextMutedBrush}" FontSize="18" Cursor="Hand" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>