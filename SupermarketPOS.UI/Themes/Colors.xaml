<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Palette -->
    <Color x:Key="BackgroundPrimary">#1E1E1E</Color>
    <Color x:Key="BackgroundSecondary">#252526</Color>
    <Color x:Key="BackgroundSurfaceElevated">#2A2A2E</Color>
    <Color x:Key="BackgroundHover">#2D2D30</Color>
    <Color x:Key="BorderColor">#3A3A3A</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#B0B0B0</Color>
    <Color x:Key="Accent">#00C853</Color>
    <Color x:Key="Danger">#FF5252</Color>
    <Color x:Key="Warning">#FFC107</Color>
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Info">#3B82F6</Color>

    <!-- Input Brushes -->
    <Color x:Key="InputBackground">#1E1E1E</Color>
    <Color x:Key="InputBorder">#3A3A3A</Color>
    <Color x:Key="InputFocusBorder">#00C853</Color>
    <Color x:Key="InputDisabled">#2A2A2E</Color>

    <!-- Sidebar -->
    <Color x:Key="SidebarBackground">#0F141E</Color>
    <Color x:Key="SidebarText">#FFFFFF</Color>
    <Color x:Key="SidebarHover">#1A2332</Color>
    <Color x:Key="SidebarActive">#1A3A2A</Color>
    <Color x:Key="SidebarActiveIndicator">#10B981</Color>
    <Color x:Key="SidebarDivider">#2A3442</Color>
    <Color x:Key="SidebarIcon">#6B7A8F</Color>
    <Color x:Key="SidebarSubText">#B0B8C5</Color>
    <Color x:Key="SidebarArrow">#6B7A8F</Color>
</ResourceDictionary>