<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="SidebarBgBrush" Color="#0F141E"/>
    <SolidColorBrush x:Key="SidebarCategoryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarItemTextBrush" Color="#B0B8C5"/>
    <SolidColorBrush x:Key="SidebarHoverBgBrush" Color="#1A2332"/>
    <SolidColorBrush x:Key="SidebarActiveBgBrush" Color="#1A3A2A"/>
    <SolidColorBrush x:Key="SidebarActiveIndicatorBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#2A3442"/>
    <SolidColorBrush x:Key="SidebarIconBrush" Color="#6B7A8F"/>

    <Style x:Key="SidebarCategoryStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource SidebarCategoryTextBrush}"/>
        <Setter Property="Margin" Value="16,20,0,8"/>
    </Style>

    <Style x:Key="SidebarMenuItemStyle" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="8,2,8,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SidebarItemTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="16,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="activeIndicator" Grid.Column="0" Background="Transparent" CornerRadius="2" Width="3" HorizontalAlignment="Left"/>
                            <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHoverBgBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarActiveBgBrush}"/>
                            <Setter TargetName="activeIndicator" Property="Background" Value="{StaticResource SidebarActiveIndicatorBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource SidebarDividerBrush}"/>
        <Setter Property="Margin" Value="16,8,16,8"/>
    </Style>
</ResourceDictionary>