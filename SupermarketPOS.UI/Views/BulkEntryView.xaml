<UserControl x:Class="SupermarketPOS.UI.Views.BulkEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="إدخال جماعي" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="جدول كـ Excel — Tab/Enter للتنقل" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="📄 قالب Excel" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="TemplateButton_Click"/>
                <Button Content="📥 استيراد" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ImportButton_Click"/>
                <Button Content="💾 حفظ الكل" Style="{DynamicResource SuccessButtonStyle}" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="0">
            <DataGrid x:Name="BulkGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      HeadersVisibility="Column"
                      CellEditEnding="BulkGrid_CellEditEnding"
                      PreviewKeyDown="BulkGrid_PreviewKeyDown"
                      LoadingRow="BulkGrid_LoadingRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    <DataGridComboBoxColumn Header="الفئة"
                                            SelectedValueBinding="{Binding CategoryId, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Id"
                                            DisplayMemberPath="Name"
                                            Width="140"
                                            x:Name="CategoryColumn"/>
                    <DataGridComboBoxColumn Header="الوحدة"
                                            SelectedValueBinding="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Id"
                                            DisplayMemberPath="Name"
                                            Width="120"
                                            x:Name="UnitColumn"/>
                    <DataGridTextColumn Header="سعر الشراء" Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTextColumn Header="سعر البيع" Binding="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTextColumn Header="حد الطلب" Binding="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="ملاحظات / أخطاء" Binding="{Binding ErrorMessage}" Width="220" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,8"
                Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="6">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondaryBrush}" Text=""/>
        </Border>
    </Grid>
</UserControl>