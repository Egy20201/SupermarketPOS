<Window x:Class="SupermarketPOS.UI.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="350" Height="160" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}">
    <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="12" Margin="8" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
            <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,0,0,16"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إلغاء" Style="{DynamicResource SecondaryButtonStyle}" Width="80" Click="Cancel_Click"/>
                <Button Content="موافق" Style="{DynamicResource SuccessButtonStyle}" Width="80" Margin="8,0,0,0" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>