<UserControl x:Class="SupermarketPOS.UI.Views.UnitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="الوحدات" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="قائمة + تحرير مباشر" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,4,0,0"/>
            </StackPanel>
            <Button Content="🔄 تحديث" Style="{DynamicResource SecondaryButtonStyle}" Width="100"
                    HorizontalAlignment="Left" Click="RefreshButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="360" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="0">
                <DataGrid x:Name="UnitsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column"
                          SelectionChanged="UnitsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="140"/>
                        <DataGridTextColumn Header="معامل التحويل" Binding="{Binding ConversionFactor}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>

            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="بيانات الوحدة" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="الاسم" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="NameBox" Margin="0,4,0,10"/>

                    <TextBlock Text="النوع" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="TypeCombo" Margin="0,4,0,10" IsEditable="True">
                        <ComboBoxItem Content="قطعة"/>
                        <ComboBoxItem Content="وزن"/>
                        <ComboBoxItem Content="حجم"/>
                        <ComboBoxItem Content="طول"/>
                        <ComboBoxItem Content="عبوة"/>
                    </ComboBox>

                    <TextBlock Text="معامل التحويل" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="FactorBox" Margin="0,4,0,16" Text="1"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="➕ جديد" Style="{DynamicResource SecondaryButtonStyle}" Width="100" Click="NewButton_Click"/>
                        <Button Content="💾 حفظ" Style="{DynamicResource SuccessButtonStyle}" Width="100" Margin="8,0,0,0" Click="SaveButton_Click"/>
                        <Button Content="🗑 حذف" Style="{DynamicResource DangerButtonStyle}" Width="100" Margin="8,0,0,0" Click="DeleteButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,8"
                Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="6">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondaryBrush}" Text=""/>
        </Border>
    </Grid>
</UserControl>