<Window x:Class="SupermarketPOS.UI.Views.UnitEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unit"
        Width="400"
        Height="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FlowDirection="RightToLeft">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Name" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="NameBox" Margin="0,4,0,10"/>
            <TextBlock Text="Type" Style="{StaticResource LabelStyle}"/>
            <ComboBox x:Name="TypeCombo" Margin="0,4,0,10">
                <ComboBoxItem Content="Main"/>
                <ComboBoxItem Content="Sub"/>
            </ComboBox>
            <TextBlock Text="ConversionFactor" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="FactorBox" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" Width="90" Click="Cancel_Click"/>
            <Button Content="Save" Style="{DynamicResource SuccessButtonStyle}" Width="90" Margin="8,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>