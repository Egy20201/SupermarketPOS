<controls:BasePage x:Class="SupermarketPOS.UI.Views.CategoriesView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:SupermarketPOS.UI.Controls"
                   xmlns:local="clr-namespace:SupermarketPOS.UI.Views"
                   FlowDirection="RightToLeft">

    <Grid Margin="16">
        <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="جاري التحميل..." FontSize="16" Foreground="White" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
            <WrapPanel>
                <Button Content="➕ إضافة" Style="{DynamicResource PrimaryButtonStyle}" Width="100" Margin="0,0,8,0" Click="AddButton_Click"/>
                <Button Content="✏️ تعديل" Style="{DynamicResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,0" Click="EditButton_Click"/>
                <Button Content="🗑️ حذف" Style="{DynamicResource DangerButtonStyle}" Width="100" Margin="0,0,8,0" Click="DeleteButton_Click"/>
                <Button Content="🔄 تحديث" Style="{DynamicResource IconButtonStyle}" Width="40" Click="RefreshButton_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <controls:ListViewLayout x:Name="CategoriesList" Grid.Column="0"/>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Width="2"/>

            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="بيانات الفئة" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="اسم الفئة" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="NameBox" Margin="0,4,0,12" Height="36"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"/>
                    <TextBlock Text="الوصف" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="DescriptionBox" Margin="0,4,0,16" Height="80"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"/>
                    <CheckBox x:Name="ActiveBox" Content="نشط" IsChecked="True"
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="❌ إلغاء" Style="{DynamicResource SecondaryButtonStyle}" Width="100" Click="CancelButton_Click"/>
                        <Button Content="💾 حفظ" Style="{DynamicResource SuccessButtonStyle}" Width="100" Margin="8,0,0,0" Click="SaveButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</controls:BasePage>