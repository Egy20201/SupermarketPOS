<controls:BasePage x:Class="SupermarketPOS.UI.Views.CustomersView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:SupermarketPOS.UI.Controls"
                   xmlns:local="clr-namespace:SupermarketPOS.UI.Views"
                   FlowDirection="RightToLeft">

    <Grid Margin="16">
        <Border x:Name="LoadingOverlay" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="جاري التحميل..." FontSize="16" Foreground="White" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
            <WrapPanel>
                <Button Content="➕ إضافة" Style="{DynamicResource PrimaryButtonStyle}" Width="100" Margin="0,0,8,0" Click="AddButton_Click"/>
                <Button Content="✏️ تعديل" Style="{DynamicResource SecondaryButtonStyle}" Width="100" Margin="0,0,8,0" Click="EditButton_Click"/>
                <Button Content="🗑️ حذف" Style="{DynamicResource DangerButtonStyle}" Width="100" Margin="0,0,8,0" Click="DeleteButton_Click"/>
                <Button Content="🔄 تحديث" Style="{DynamicResource IconButtonStyle}" Width="40" Click="RefreshButton_Click"/>
                <Button Content="📤 تصدير" Style="{DynamicResource IconButtonStyle}" Width="40" Margin="4,0,0,0" Click="ExportButton_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <controls:ListViewLayout x:Name="CustomersList" Grid.Column="0"/>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Width="2"/>

            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="بيانات العميل" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="اسم العميل *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="NameBox" Margin="0,4,0,12" Height="36"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"/>
                        <TextBlock Text="رقم التليفون" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="PhoneBox" Margin="0,4,0,12" Height="36"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"/>
                        <TextBlock Text="البريد الإلكتروني" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="EmailBox" Margin="0,4,0,12" Height="36"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"/>
                        <TextBlock Text="العنوان" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="AddressBox" Margin="0,4,0,12" Height="36"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"/>
                        <TextBlock Text="ملاحظات" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="NotesBox" Margin="0,4,0,16" Height="60" TextWrapping="Wrap"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"/>
                        <TextBlock Text="الرصيد الحالي" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="BalanceBox" Margin="0,4,0,16" Height="36" IsReadOnly="True"
                                 Background="{DynamicResource InputDisabledBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="❌ إلغاء" Style="{DynamicResource SecondaryButtonStyle}" 
                                    Width="100" Click="CancelButton_Click"/>
                            <Button Content="💾 حفظ" Style="{DynamicResource SuccessButtonStyle}" 
                                    Width="100" Margin="8,0,0,0" Click="SaveButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</controls:BasePage>