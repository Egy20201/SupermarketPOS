<Window x:Class="SupermarketPOS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SupermarketPOS.UI"
        Title="Supermarket ERP"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource WindowBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CollapsibleTextStyle" TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CollapsibleBorderStyle" TargetType="Border">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CollapsiblePanelStyle" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" 
                BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="ToggleSidebarButton" Width="40" Height="40"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" 
                            Click="ToggleSidebar_Click" ToolTip="إظهار/إخفاء القائمة">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="8">
                                    <TextBlock Text="☰" FontSize="22" Foreground="{DynamicResource HeaderButtonForegroundBrush}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource HeaderButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="PageTitleText" Text="لوحة التحكم" FontSize="18" FontWeight="SemiBold" 
                               Foreground="{DynamicResource PageTitleBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="─" Width="40" Height="40" Background="Transparent" 
                            Foreground="{DynamicResource HeaderButtonForegroundBrush}" 
                            BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource HeaderButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="🗗" Width="40" Height="40" Background="Transparent" 
                            Foreground="{DynamicResource HeaderButtonForegroundBrush}" 
                            BorderThickness="0" Cursor="Hand" Click="MaximizeButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource HeaderButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="✕" Width="40" Height="40" Background="Transparent" 
                            Foreground="{DynamicResource HeaderButtonForegroundBrush}" 
                            BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource CloseButtonHoverBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}" Margin="0,10,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border x:Name="SidebarBorder" Grid.Column="0" Width="260" 
                        Background="{DynamicResource SidebarBackgroundBrush}" 
                        CornerRadius="12" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <Border Grid.Row="0" Padding="16,16,16,12">
                            <StackPanel>
                                <TextBlock Text="Supermarket" FontSize="18" FontWeight="Bold" 
                                           Foreground="{DynamicResource SidebarTextBrush}"
                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                <TextBlock Text="ERP System" FontSize="11" 
                                           Foreground="{DynamicResource SidebarArrowBrush}"
                                           Style="{StaticResource CollapsibleTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Divider -->
                        <Border Grid.Row="0" Height="1" Background="{DynamicResource SidebarDividerBrush}" 
                                Margin="16,0,16,0" VerticalAlignment="Bottom"
                                Style="{StaticResource CollapsibleBorderStyle}"/>

                        <!-- Navigation Menu -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,8,0,0">
                                <!-- Dashboard -->
                                <Button x:Name="DashboardButton" Height="48" Margin="8,2,8,2"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Click="NavigateToDashboard_Click" ToolTip="الرئيسية">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="🏠" FontSize="18" 
                                                               Foreground="{DynamicResource SidebarIconBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="الرئيسية" FontSize="13" FontWeight="SemiBold" 
                                                               Foreground="{DynamicResource SidebarTextBrush}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                                               Style="{StaticResource CollapsibleTextStyle}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Divider -->
                                <Border Height="1" Background="{DynamicResource SidebarDividerBrush}" Margin="16,8,16,8"
                                        Style="{StaticResource CollapsibleBorderStyle}"/>

                                <!-- Sales -->
                                <Expander x:Name="SalesExpander" Margin="0,2,0,2" Style="{StaticResource SidebarExpanderStyle}">
                                    <Expander.Header>
                                        <Border Background="Transparent" CornerRadius="10" Margin="8,2,8,2" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🛒" FontSize="18" 
                                                           Foreground="{DynamicResource SidebarIconBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="إدارة المبيعات" FontSize="13" FontWeight="Bold" 
                                                           Foreground="{DynamicResource SidebarTextBrush}"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                                <TextBlock Grid.Column="2" Text="▶" FontSize="10" 
                                                           Foreground="{DynamicResource SidebarArrowBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>
                                    <StackPanel Margin="24,4,8,8" Style="{StaticResource CollapsiblePanelStyle}">
                                        <Button Content="نقطة البيع (POS)" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToPOS_Click"/>
                                        <Button Content="العملاء" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToCustomers_Click"/>
                                        <Button Content="كشف حساب عميل" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToCustomerStatement_Click"/>
                                        <Button Content="سداد عميل" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToCustomerPayment_Click"/>
                                        <Button Content="أرصدة العملاء" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToCustomerBalance_Click"/>
                                        <Button Content="مرتجعات المبيعات" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToSalesReturn_Click"/>
                                        <Button Content="تقرير المبيعات" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToSalesReport_Click"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Inventory -->
                                <Expander x:Name="InventoryExpander" Margin="0,2,0,2" Style="{StaticResource SidebarExpanderStyle}">
                                    <Expander.Header>
                                        <Border Background="Transparent" CornerRadius="10" Margin="8,2,8,2" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📦" FontSize="18" 
                                                           Foreground="{DynamicResource SidebarIconBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="إدارة المخازن" FontSize="13" FontWeight="Bold" 
                                                           Foreground="{DynamicResource SidebarTextBrush}"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                                <TextBlock Grid.Column="2" Text="▶" FontSize="10" 
                                                           Foreground="{DynamicResource SidebarArrowBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>
                                    <StackPanel Margin="24,4,8,8" Style="{StaticResource CollapsiblePanelStyle}">
                                        <Button Content="إدارة المنتجات" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToProductsView_Click"/>
                                        <Button Content="الفئات" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToCategoriesView_Click"/>
                                        <Button Content="الوحدات" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToUnitsView_Click"/>
                                        <Button Content="إدخال جماعي" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToBulkEntryView_Click"/>
                                        <Button Content="المخازن" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToWarehouses_Click"/>
                                        <Button Content="تحويل بين المخازن" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToStockTransfer_Click"/>
                                        <Button Content="جرد المخزون" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToStockTake_Click"/>
                                        <Button Content="تالف / هالك" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToStockLoss_Click"/>
                                        <Button Content="كارت الصنف" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToStockCard_Click"/>
                                        <Button Content="تقييم المخزون" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToInventoryReport_Click"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Purchases -->
                                <Expander x:Name="PurchasesExpander" Margin="0,2,0,2" Style="{StaticResource SidebarExpanderStyle}">
                                    <Expander.Header>
                                        <Border Background="Transparent" CornerRadius="10" Margin="8,2,8,2" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🧾" FontSize="18" 
                                                           Foreground="{DynamicResource SidebarIconBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="إدارة المشتريات" FontSize="13" FontWeight="Bold" 
                                                           Foreground="{DynamicResource SidebarTextBrush}"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                                <TextBlock Grid.Column="2" Text="▶" FontSize="10" 
                                                           Foreground="{DynamicResource SidebarArrowBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>
                                    <StackPanel Margin="24,4,8,8" Style="{StaticResource CollapsiblePanelStyle}">
                                        <Button Content="فواتير الشراء" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToPurchases_Click"/>
                                        <Button Content="الموردين" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToSuppliers_Click"/>
                                        <Button Content="مرتجعات المشتريات" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToPurchaseReturn_Click"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Accounting -->
                                <Expander x:Name="AccountingExpander" Margin="0,2,0,2" Style="{StaticResource SidebarExpanderStyle}">
                                    <Expander.Header>
                                        <Border Background="Transparent" CornerRadius="10" Margin="8,2,8,2" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="💰" FontSize="18" 
                                                           Foreground="{DynamicResource SidebarIconBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="إدارة الحسابات" FontSize="13" FontWeight="Bold" 
                                                           Foreground="{DynamicResource SidebarTextBrush}"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                                <TextBlock Grid.Column="2" Text="▶" FontSize="10" 
                                                           Foreground="{DynamicResource SidebarArrowBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>
                                    <StackPanel Margin="24,4,8,8" Style="{StaticResource CollapsiblePanelStyle}">
                                        <Button Content="دفتر الأستاذ العام" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToGeneralLedger_Click"/>
                                        <Button Content="شجرة الحسابات" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToChartOfAccounts_Click"/>
                                        <Button Content="قيد يومية" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToJournal_Click"/>
                                        <Button Content="ميزان المراجعة" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToTrialBalance_Click"/>
                                        <Button Content="الأرباح والخسائر" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToProfitLoss_Click"/>
                                        <Button Content="الميزانية العمومية" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToBalanceSheet_Click"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Reports -->
                                <Expander x:Name="ReportsExpander" Margin="0,2,0,2" Style="{StaticResource SidebarExpanderStyle}">
                                    <Expander.Header>
                                        <Border Background="Transparent" CornerRadius="10" Margin="8,2,8,2" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📊" FontSize="18" 
                                                           Foreground="{DynamicResource SidebarIconBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="التقارير" FontSize="13" FontWeight="Bold" 
                                                           Foreground="{DynamicResource SidebarTextBrush}"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                                <TextBlock Grid.Column="2" Text="▶" FontSize="10" 
                                                           Foreground="{DynamicResource SidebarArrowBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>
                                    <StackPanel Margin="24,4,8,8" Style="{StaticResource CollapsiblePanelStyle}">
                                        <Button Content="تقرير المبيعات" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToSalesReport_Click"/>
                                        <Button Content="تقرير المشتريات" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToPurchaseReport_Click"/>
                                        <Button Content="تقرير VAT" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToVATReport_Click"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Settings -->
                                <Expander x:Name="SettingsExpander" Margin="0,2,0,2" Style="{StaticResource SidebarExpanderStyle}">
                                    <Expander.Header>
                                        <Border Background="Transparent" CornerRadius="10" Margin="8,2,8,2" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="⚙️" FontSize="18" 
                                                           Foreground="{DynamicResource SidebarIconBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="الإعدادات" FontSize="13" FontWeight="Bold" 
                                                           Foreground="{DynamicResource SidebarTextBrush}"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                                <TextBlock Grid.Column="2" Text="▶" FontSize="10" 
                                                           Foreground="{DynamicResource SidebarArrowBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>
                                    <StackPanel Margin="24,4,8,8" Style="{StaticResource CollapsiblePanelStyle}">
                                        <Button Content="المستخدمين" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToUsers_Click"/>
                                        <Button Content="الصلاحيات" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToRoleManagement_Click"/>
                                        <Button Content="نسخ احتياطي" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToBackup_Click"/>
                                        <Button Content="سجل التدقيق" Height="36" Background="Transparent" 
                                                Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" 
                                                HorizontalAlignment="Left" Cursor="Hand" Click="NavigateToAuditLog_Click"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Phase 3: Dynamic Entities (auto-populated from metadata) -->
                                <Border Height="1" Background="{DynamicResource SidebarDividerBrush}" Margin="16,8,16,8"
                                        Style="{StaticResource CollapsibleBorderStyle}"/>
                                <Expander x:Name="DynamicEntitiesExpander" Margin="0,2,0,2" Style="{StaticResource SidebarExpanderStyle}">
                                    <Expander.Header>
                                        <Border Background="Transparent" CornerRadius="10" Margin="8,2,8,2" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#x26A1;" FontSize="18" 
                                                           Foreground="{DynamicResource SidebarIconBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="&#x0627;&#x0644;&#x0643;&#x064A;&#x0627;&#x0646;&#x0627;&#x062A;" FontSize="13" FontWeight="Bold" 
                                                           Foreground="{DynamicResource SidebarTextBrush}"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                                <TextBlock Grid.Column="2" Text="&#x25B6;" FontSize="10" 
                                                           Foreground="{DynamicResource SidebarArrowBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Style="{StaticResource CollapsibleTextStyle}"/>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>
                                    <StackPanel x:Name="DynamicEntitiesPanel" Margin="24,4,8,8" 
                                                Style="{StaticResource CollapsiblePanelStyle}"/>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- User Profile -->
                        <Border Grid.Row="2" Background="{DynamicResource UserProfileBackgroundBrush}" 
                                CornerRadius="12" Margin="8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                        Cursor="Hand" ToolTip="الملف الشخصي"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10B981" Offset="0"/>
                                            <GradientStop Color="#059669" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                                    </Border.Effect>
                                    <TextBlock Text="👤" FontSize="18" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                            Style="{StaticResource CollapsiblePanelStyle}">
                                    <TextBlock x:Name="SidebarUserNameText" Text="مدير النظام" 
                                               Foreground="{DynamicResource SidebarTextBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock x:Name="SidebarUserRoleText" Text="Administrator" 
                                               Foreground="{DynamicResource SidebarArrowBrush}" FontSize="10"/>
                                </StackPanel>

                                <Button Grid.Column="2" Width="32" Height="32"
                                        Background="Transparent" Foreground="{DynamicResource LogoutButtonBrush}" 
                                        BorderThickness="0" Cursor="Hand"
                                        Click="Logout_Click" ToolTip="تسجيل الخروج">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="8">
                                                <TextBlock Text="🚪" FontSize="16" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource LogoutHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tab Control -->
                <Border Grid.Column="1" Background="Transparent">
                    <TabControl x:Name="MainTabControl" Margin="16,0,0,0" Background="{DynamicResource SurfaceBrush}" SelectionChanged="MainTabControl_SelectionChanged"/>
                </Border>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource FooterBackgroundBrush}" 
                BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,1,0,0" Padding="16,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ConnectionStatusText" Text="🟢 متصل" FontSize="11" 
                           Foreground="{DynamicResource ConnectionStatusBrush}"/>
                <TextBlock Text="|" Foreground="{DynamicResource HeaderBorderBrush}" Margin="12,0"/>
                <TextBlock x:Name="DateTimeText" FontSize="11" Foreground="{DynamicResource DateTimeBrush}"/>
                <TextBlock Text="|" Foreground="{DynamicResource HeaderBorderBrush}" Margin="12,0"/>
                <TextBlock x:Name="SyncStatusText" Text="✅ متزامن" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                <TextBlock Text="|" Foreground="{DynamicResource HeaderBorderBrush}" Margin="12,0"/>
                <TextBlock x:Name="HealthIndicatorText" Text="🟢 سليم" FontSize="11" Foreground="{DynamicResource ConnectionStatusBrush}" ToolTip="حالة معالج الأحداث"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>