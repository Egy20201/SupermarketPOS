<UserControl x:Class="SupermarketPOS.UI.Controls.FormLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{DynamicResource CardBorderStyle}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FormTitle" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SaveButton" Content="💾 حفظ" 
                                Style="{DynamicResource SuccessButtonStyle}" Width="100" Margin="0,0,8,0"/>
                        <Button x:Name="CancelButton" Content="❌ إلغاء" 
                                Style="{DynamicResource SecondaryButtonStyle}" Width="100"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl x:Name="SectionsContainer"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>